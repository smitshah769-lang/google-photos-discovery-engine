# Help Community thread discovery (Google Programmable Search JSON API).
# The embed snippet from CSE only gives you CX — you still need a Cloud API key.
#
# 1) CX: from your embed URL, e.g. cse.js?cx=YOUR_CX_HERE
GOOGLE_CSE_CX=

# 2) API key: Google Cloud Console → APIs & Services → Enable "Custom Search API"
#    → Credentials → Create API key (restrict to Custom Search API if you like)
GOOGLE_CSE_API_KEY=

# Search summaries (pick one free provider; synthesis auto-enables when a key is set):
# Gemini (recommended for this project): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
# GROQ_API_KEY=
# Hugging Face Inference (read token): https://huggingface.co/settings/tokens
# HF_TOKEN=

# Optional HTTP basic auth for the read-only research API (required if binding 0.0.0.0).
# DISCOVERY_BASIC_USER=reviewer
# DISCOVERY_BASIC_PASSWORD=change-me
# NEXT_PUBLIC_DISCOVERY_BASIC_AUTH=reviewer:change-me
